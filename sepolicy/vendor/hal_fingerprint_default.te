rw_dir_file(hal_fingerprint_default,sysfs_lge_touch)
get_prop(hal_fingerprint_default, vendor_lge_fingerprint_prop)

# The device-specific system helper owns the SurfaceFlinger dim layer.
typeattribute hal_fingerprint_default socket_between_core_and_vendor_violators;
unix_socket_connect(hal_fingerprint_default, lge_fod, lge_fod)

allow hal_fingerprint_default fingerprint_device:chr_file rw_file_perms;
allow hal_fingerprint_default tee_device:chr_file rw_file_perms;
allow hal_fingerprint_default self:netlink_socket { read write bind create };

binder_call(hal_fingerprint_default, hal_powerhint_default)
allow hal_fingerprint_default hal_lge_powerhint_hwservice:hwservice_manager find;

allow hal_fingerprint_default mnt_vendor_file:dir search;
r_dir_file(hal_fingerprint_default, persist_lg_data_file)
