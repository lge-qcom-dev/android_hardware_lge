on init
    chown system system /sys/power/wake_lock
    chmod 0660 /sys/power/wake_lock
    chown system system /sys/power/wake_unlock
    chmod 0660 /sys/power/wake_unlock
    chown system system /sys/class/dualscreen/ds2/ds2_hal_ready
    chmod 0660 /sys/class/dualscreen/ds2/ds2_hal_ready
    chown system system /sys/class/dualscreen/ds2/ds2_pd
    chmod 0660 /sys/class/dualscreen/ds2/ds2_pd

service vendor.dualscreen /vendor/bin/hw/vendor.lge.hardware.dualscreen-service
    class hal
    user system
    group system wakelock
    capabilities BLOCK_SUSPEND
    interface aidl vendor.lge.hardware.dualscreen.IDualScreen/default
