cc_binary {
    name: "android.hardware.radio@1.5-service.lge",
    cflags: [
        "-Wno-unused-variable",
        "-Wno-unused-parameter",
    ],
    owner: "lineage",
    relative_install_path: "hw",
    vendor: true,
    init_rc: ["android.hardware.radio@1.5-service.lge.rc"],
    srcs: [
        "Radio.cpp",
        "RadioIndication.cpp",
        "RadioResponse.cpp",
        "service.cpp",
        "Helpers.cpp",
        "hidl-utils.cpp",
        "LgeRadioIndicationV2.cpp",
        "LgeRadioResponseV2.cpp",
    ],
    shared_libs: [
        "libbase",
        "libhidlbase",
        "libutils",
        "android.hardware.radio@1.0",
        "android.hardware.radio@1.1",
        "android.hardware.radio@1.2",
        "android.hardware.radio@1.3",
        "android.hardware.radio@1.4",
        "android.hardware.radio@1.5",
        "vendor.lge.hardware.radio@2.0",
        "android.hidl.safe_union@1.0",
    ],
}

// Shared in-process LG backend, without a second published HIDL service.
filegroup {
    name: "lge-radio-wrapper-sources",
    srcs: ["Radio.cpp", "RadioIndication.cpp", "RadioResponse.cpp", "Helpers.cpp",
           "LgeRadioIndicationV2.cpp", "LgeRadioResponseV2.cpp", "hidl-utils.cpp"],
}
cc_library_headers {
    name: "lge-radio-wrapper-headers",
    vendor: true,
    export_include_dirs: ["."],
}
